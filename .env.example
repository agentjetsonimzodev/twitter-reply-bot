# ============================================================================
# Twitter Reply Bot — environment variables template
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================================

# ----------------------------------------------------------------------------
# X API (writes via tweepy — OAuth 1.0a user-context, Free tier)
# Get these from https://developer.x.com after creating a project + app.
# App permissions: Read + Write. Use case: "personal automation tool".
# ----------------------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# ----------------------------------------------------------------------------
# twikit (reads — cookie auth, NO official API)
# Use the SAME account as your X app, or a separate dedicated bot account.
# ----------------------------------------------------------------------------
TWIKIT_USERNAME=
TWIKIT_PASSWORD=
# TOTP secret (the otpauth:// string from your authenticator QR setup,
# NOT the current 6-digit code). Enable 2FA on the bot account first.
TWIKIT_2FA_SECRET=

# ----------------------------------------------------------------------------
# LLM provider — pick ONE and comment out the others
# ----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Local Ollama (no API key needed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ----------------------------------------------------------------------------
# Bot behavior
# ----------------------------------------------------------------------------
# Comma-separated keywords to search and reply to.
BOT_KEYWORDS=indie hacker,build in public,ship log

# Tone/persona hint passed to the LLM.
BOT_PERSONA=A pragmatic indie hacker who shares specific, useful tips.

# Max replies per scheduled run (safety cap).
BOT_MAX_REPLIES_PER_RUN=10

# Daily soft cap. If you exceed this, the bot skips remaining replies today.
BOT_DAILY_REPLY_CAP=20

# Monthly hard cap (X Free tier = 1500; keep headroom).
BOT_MONTHLY_REPLY_CAP=500

# Min/max jitter between actions (seconds).
BOT_JITTER_MIN_S=5
BOT_JITTER_MAX_S=30

# Stop after this many consecutive errors (kill switch).
BOT_MAX_CONSECUTIVE_ERRORS=5

# ----------------------------------------------------------------------------
# Storage & logging
# ----------------------------------------------------------------------------
DB_PATH=./bot.db
COOKIES_PATH=./cookies.json
LOG_PATH=./bot.log
LOG_LEVEL=INFO
